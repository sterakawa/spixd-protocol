{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SPIXD ready message v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "sessionId",
    "status",
    "files"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "status": {
      "const": "ready"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+\\.(jpg|jpeg|JPG|JPEG)$"
      }
    }
  }
}
