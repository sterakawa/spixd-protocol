{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SPIXD result message v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "sessionId",
    "status"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "status": {
      "enum": [
        "uploading",
        "available",
        "retrying",
        "failed"
      ]
    },
    "albumUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "errorCode": {
      "type": "string"
    },
    "message": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "available"
          }
        }
      },
      "then": {
        "required": [
          "albumUrl"
        ]
      }
    }
  ]
}
